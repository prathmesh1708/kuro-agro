# Environment Variables for Appzeto Multi-Vendor Backend
# Copy this file to .env and fill in your values

# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ─── MongoDB ─────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/appzeto

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=your_access_secret_change_this_in_production
JWT_REFRESH_SECRET=your_refresh_secret_change_this_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Cloudinary ──────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
FROM_NAME=Appzeto Store
FROM_EMAIL=noreply@appzeto.com

# ─── Razorpay ─────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ─── Third-Party Delivery Provider ───────────────────────────────────────────
# Options: internal (default/noop) | shiprocket | mock (for dev testing)
# Set to "internal" if you use your own delivery boys only.
DELIVERY_PROVIDER=internal

# Shiprocket credentials (only needed when DELIVERY_PROVIDER=shiprocket)
SHIPROCKET_EMAIL=your_shiprocket_account@email.com
SHIPROCKET_PASSWORD=your_shiprocket_password
SHIPROCKET_WEBHOOK_SECRET=your_shiprocket_webhook_secret
SHIPROCKET_CHANNEL_ID=your_channel_id

# Pickup / Warehouse address (used when creating Shiprocket orders)
PICKUP_NAME=Primary Warehouse
PICKUP_PHONE=9000000000
PICKUP_ADDRESS=123 Warehouse Street
PICKUP_CITY=Mumbai
PICKUP_STATE=Maharashtra
PICKUP_PINCODE=400001

# ─── SMS Gateway (SMS India Hub / Fast2SMS / Twilio) ───────────────────────────
# Options: console | smsindiahub | fast2sms | twilio
SMS_PROVIDER=smsindiahub

# SMS India Hub credentials (DLT Compliant India SMS Gateway)
SMS_INDIA_HUB_API_KEY=your_sms_india_hub_api_key
SMS_INDIA_HUB_SENDER_ID=your_sender_id
SMS_INDIA_HUB_ENTITY_ID=your_dlt_entity_id
SMS_INDIA_HUB_TEMPLATE_ID=your_dlt_template_id
# Optional custom template text:
# SMS_INDIA_HUB_TEMPLATE_TEXT="Your OTP for Raathi is {#var#}. Valid for 10 minutes."
SMS_INDIA_HUB_CHANNEL=2
SMS_INDIA_HUB_ROUTE=1

# Fast2SMS credentials (Alternative Indian SMS Provider)
FAST2SMS_API_KEY=your_fast2sms_api_key

# Twilio credentials (for international/production SMS)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number


